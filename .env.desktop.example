# Copy this file to .env beside "Tra Cuu Hoa Don.exe"
# and replace the value with your Neon PostgreSQL connection string.
# Recommended: authenticate through the deployed webapp, then process GDT locally.
AUTH_WEBAPP_URL=https://your-app.vercel.app

# Alternative: connect the desktop app directly to Neon.
# DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require

# Optional: use a separate stable signing secret for desktop sessions.
# AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional: Gemini API key for server-side captcha OCR.
# GEMINI_API_KEY=
