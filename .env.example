# Gemini API Key (Required for AI Vision Captcha solving)
GEMINI_API_KEY=
# One AI request per image; no multi-model fallback. Usage is logged as [CAPTCHA usage].
CAPTCHA_AI_MODEL=gemini-2.5-flash-lite
CAPTCHA_AI_ENABLED=true

# PostgreSQL Database Connection URL (Optional, uses in-memory mock when empty)
DATABASE_URL=

# Initial Admin Credentials (Optional)
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_FULLNAME=

# Debug and Logging
DEBUG_OCR=
PORT=3000
