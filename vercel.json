{
  "version": 2,
  "regions": ["sin1"],
  "outputDirectory": "dist",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm install --include=optional",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://pmkt.nghiatingold.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
